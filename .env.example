# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Nutrition API Keys (choose based on implementation)
# EDAMAM_APP_ID=your_edamam_app_id_here
# EDAMAM_APP_KEY=your_edamam_app_key_here
# SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# Environment
NODE_ENV=development

# Enable mock mode (true/false) to bypass actual API calls
USE_MOCK_MODE=false

# OpenAI Rate Limiting Configuration
# Number of retries when hitting rate limits
OPENAI_MAX_RETRIES=5
# Initial delay between retries in milliseconds
OPENAI_INITIAL_DELAY_MS=1000
# Maximum delay between retries in milliseconds
OPENAI_MAX_DELAY_MS=60000
# Factor to increase delay by after each retry
OPENAI_BACKOFF_FACTOR=2
